{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResumeSystemSchema",
  "description": "Schema for the multi-profile resume management system of rajasekar.work",
  "type": "object",
  "properties": {
    "masterResume": {
      "type": "object",
      "required": ["name", "title", "summary", "contact", "proof", "experience", "skills", "education"],
      "properties": {
        "name": { "type": "string" },
        "title": { "type": "string" },
        "summary": { "type": "string" },
        "contact": {
          "type": "object",
          "properties": {
            "phone": { "$ref": "#/$defs/contactItem" },
            "email": { "$ref": "#/$defs/contactItem" },
            "linkedin": { "$ref": "#/$defs/contactItem" },
            "github": { "$ref": "#/$defs/contactItem" },
            "portfolio": { "$ref": "#/$defs/contactItem" },
            "creative": { "$ref": "#/$defs/contactItem" }
          }
        },
        "proof": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "text"],
            "properties": {
              "id": { "type": "string" },
              "value": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "experience": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["org", "role", "period", "bullets"],
            "properties": {
              "id": { "type": "string" },
              "org": { "type": "string" },
              "role": { "type": "string" },
              "period": { "type": "string" },
              "bullets": {
                "type": "array",
                "items": { "type": "string" }
              },
              "bulletDetails": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "text": { "type": "string" },
                    "tags": { "type": "array", "items": { "type": "string" } }
                  }
                }
              },
              "track": { "type": "string", "enum": ["enterprise", "independent", "contract"] }
            }
          }
        },
        "independentWork": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "role", "period", "description", "technologies"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "role": { "type": "string" },
              "period": { "type": "string" },
              "description": { "type": "string" },
              "technologies": { "type": "array", "items": { "type": "string" } },
              "links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": { "type": "string" },
                    "url": { "type": "string" }
                  }
                }
              },
              "bullets": { "type": "array", "items": { "type": "string" } },
              "track": { "type": "string", "enum": ["independent"] }
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["group", "items"],
            "properties": {
              "id": { "type": "string" },
              "group": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "education": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["level", "place", "meta"],
            "properties": {
              "id": { "type": "string" },
              "level": { "type": "string" },
              "place": { "type": "string" },
              "meta": { "type": "string" }
            }
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/profile" }
    },
    "applications": {
      "type": "array",
      "items": { "$ref": "#/$defs/jobApplication" }
    }
  },
  "$defs": {
    "contactItem": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "sectionVisibility": {
      "type": "object",
      "properties": {
        "proof": { "type": "boolean", "default": true },
        "summary": { "type": "boolean", "default": true },
        "skills": { "type": "boolean", "default": true },
        "experience": { "type": "boolean", "default": true },
        "projects": { "type": "boolean", "default": false },
        "education": { "type": "boolean", "default": true },
        "contact": { "type": "boolean", "default": true }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "name", "targetTitle"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "isDefault": { "type": "boolean", "default": false },
        "targetTitle": { "type": "string" },
        "summaryOverride": { "type": ["string", "null"] },
        "selectedExperience": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of experience IDs to include"
        },
        "selectedSkills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of skill group IDs or skill names"
        },
        "selectedProjects": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of independent work IDs"
        },
        "sectionVisibility": { "$ref": "#/$defs/sectionVisibility" },
        "layout": {
          "type": "string",
          "enum": ["ats-classic", "modern-visual", "executive"],
          "default": "ats-classic"
        },
        "accentColor": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "jobApplication": {
      "type": "object",
      "required": ["id", "company", "jobTitle", "applicationDate", "profileId", "status"],
      "properties": {
        "id": { "type": "string" },
        "company": { "type": "string" },
        "jobTitle": { "type": "string" },
        "jobDescription": { "type": "string" },
        "applicationDate": { "type": "string" },
        "profileId": { "type": "string" },
        "selectedSkills": { "type": "array", "items": { "type": "string" } },
        "selectedExperience": { "type": "array", "items": { "type": "string" } },
        "generatedResumeVersion": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["Draft", "Applied", "Screening", "Interviewing", "Offered", "Rejected", "Archived"]
        },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    }
  }
}
